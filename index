
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brotherhood or Sisterhood</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="background default active"></div>
    <div class="background brotherhood"></div>
    <div class="background sisterhood"></div>

    <div class="overlay"></div>

    <main class="container">
        <p class="subtitle">TWO PATHS. ONE COMMUNITY.</p>

        <h1>WHERE DO YOU BELONG?</h1>

        <div class="options">

            <a href="brotherhood.html" class="option" data-image="brotherhood">
                <span>01</span>
                <h2>BROTHERHOOD</h2>
                <p>Strength. Loyalty. Unity.</p>
                <div class="line"></div>
            </a>

            <a href="sisterhood.html" class="option" data-image="sisterhood">
                <span>02</span>
                <h2>SISTERHOOD</h2>
                <p>Grace. Empowerment. Unity.</p>
                <div class="line"></div>
            </a>

        </div>

        <p class="footer">CHOOSE YOUR SIDE</p>
    </main>

    <script src="script.js"></script>
</body>
</html>


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 100vh;
    overflow: hidden;
    font-family: 'Arial', sans-serif;
    color: white;
    background: #111;
}

.background {
    position: fixed;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1s ease;
    z-index: -3;
}

.background.active {
    opacity: 1;
}

/* Default background */
.default {
    background-image: url(
      "https://images.unsplash.com/photo-1519608487953-e999c86e7455"
    );
}

/* Brotherhood background */
.brotherhood {
    background-image: url(
      "https://images.unsplash.com/photo-1517841905240-472988babdf9"
    );
}

/* Sisterhood background */
.sisterhood {
    background-image: url(
      "https://images.unsplash.com/photo-1524504388940-b1c1722653e1"
    );
}

.overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.58);
    z-index: -2;
}

.container {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 25px;
}

.subtitle {
    font-size: 11px;
    letter-spacing: 6px;
    margin-bottom: 25px;
    opacity: 0.8;
}

h1 {
    font-size: clamp(25px, 4vw, 48px);
    font-weight: 300;
    letter-spacing: 5px;
    margin-bottom: 70px;
}

.options {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 80px;
}

.option {
    color: white;
    text-decoration: none;
    width: 300px;
    padding: 30px 20px;
    border-top: 1px solid rgba(255,255,255,0.6);
    transition: all 0.5s ease;
}

.option span {
    font-size: 12px;
    letter-spacing: 4px;
    opacity: 0.7;
}

.option h2 {
    font-size: 27px;
    font-weight: 400;
    letter-spacing: 4px;
    margin: 25px 0 15px;
    transition: letter-spacing 0.4s ease;
}

.option p {
    font-size: 11px;
    letter-spacing: 2px;
    opacity: 0.8;
}

.line {
    width: 0;
    height: 1px;
    background: white;
    margin: 25px auto 0;
    transition: width 0.5s ease;
}

.option:hover {
    transform: translateY(-8px);
}

.option:hover h2 {
    letter-spacing: 7px;
}

.option:hover .line {
    width: 80%;
}

.footer {
    position: absolute;
    bottom: 35px;
    font-size: 10px;
    letter-spacing: 5px;
    opacity: 0.6;
}

@media (max-width: 650px) {
    body {
        overflow: auto;
    }

    .container {
        min-height: 100vh;
        height: auto;
        padding: 50px 20px;
    }

    h1 {
        margin-bottom: 40px;
    }

    .options {
        flex-direction: column;
        gap: 30px;
    }

    .option {
        width: 280px;
    }

    .footer {
        position: static;
        margin-top: 50px;
    }
}


const options = document.querySelectorAll(".option");
const backgrounds = document.querySelectorAll(".background");

options.forEach(option => {

    option.addEventListener("mouseenter", () => {
        const selected = option.dataset.image;

        backgrounds.forEach(bg => {
            bg.classList.remove("active");
        });

        document.querySelector("." + selected)
            .classList.add("active");
    });

    option.addEventListener("mouseleave", () => {
        backgrounds.forEach(bg => {
            bg.classList.remove("active");
        });

        document.querySelector(".default")
            .classList.add("active");
    });

});
